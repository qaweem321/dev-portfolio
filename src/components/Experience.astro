---
import type { Portfolio } from "../lib/schema";
import Section from "./Section.astro";
import Timeline from "./Timeline.astro";

interface Props {
  portfolio: Portfolio;
  id: string;
  index: number;
  title: string;
}

const { portfolio, id, index, title } = Astro.props;
const jobs = portfolio.experience.map((job) => ({ ...job, title: job.role, at: job.company }));
const education = portfolio.education.map((item) => ({ ...item, title: item.degree, at: item.school }));
---

<Section id={id} index={index} title={title}>
  {jobs.length > 0 && <Timeline items={jobs} />}
  {
    education.length > 0 && (
      <>
        {jobs.length > 0 && <h3 class="subhead">Education</h3>}
        <Timeline items={education} />
      </>
    )
  }
</Section>

<style>
  .subhead {
    margin: 2.5rem 0 0.5rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  @media print {
    .subhead {
      margin-top: 1rem;
    }
  }
</style>
