---
import { iconPath } from "../lib/icons";
import { asset } from "../lib/paths";
import { hasContact } from "../lib/portfolio";
import type { Portfolio } from "../lib/schema";
import ExternalLink from "./ExternalLink.astro";
import Icon from "./Icon.astro";

interface Props {
  portfolio: Portfolio;
}

const { portfolio } = Astro.props;
const { person, socials } = portfolio;
const avatar =
  "seed" in person.avatar
    ? { src: asset("avatar.svg"), alt: `Illustrated avatar of ${person.name}` }
    : { src: asset(person.avatar.src), alt: person.avatar.alt };
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="container grid">
    <div class="intro">
      {
        person.availability && (
          <p class:list={["status", { open: person.availability.open }]}>
            <span class="dot" aria-hidden="true" />
            {person.availability.text}
          </p>
        )
      }
      <h1 id="hero-title">
        {person.name}
        <span class="role">{person.role}</span>
      </h1>
      <p class="tagline">{person.tagline}</p>
      {person.location && <p class="location">{person.location}</p>}
      <div class="actions no-print">
        {hasContact(portfolio) && <a class="button primary" href="#contact">Get in touch</a>}
        {
          person.resumeUrl ? (
            <ExternalLink class="button" href={person.resumeUrl}>Résumé</ExternalLink>
          ) : (
            <button class="button needs-js" type="button" data-print-resume>Save as PDF résumé</button>
          )
        }
      </div>
      <ul class="socials no-print" aria-label="Elsewhere">
        {
          socials.map((social) => (
            <li>
              <ExternalLink class="icon-button" href={social.url} me label={social.label}>
                <Icon path={iconPath(social.icon)} size={18} />
              </ExternalLink>
            </li>
          ))
        }
      </ul>
      <p class="print-contact">
        {[person.email, ...socials.map((s) => s.url)].filter(Boolean).join(" · ")}
      </p>
    </div>
    <div class="portrait no-print">
      <img src={avatar.src} alt={avatar.alt} width="320" height="320" decoding="async" />
    </div>
  </div>
</section>

<script>
  document.querySelector("[data-print-resume]")?.addEventListener("click", () => window.print());
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3.5rem, 10vw, 7rem) clamp(3rem, 8vw, 5.5rem);
  }
  .hero::before {
    content: "";
    position: absolute;
    inset: -40% -10% auto auto;
    width: 38rem;
    height: 38rem;
    border-radius: 50%;
    background: radial-gradient(circle, var(--accent-soft), transparent 65%);
    pointer-events: none;
  }
  .grid {
    position: relative;
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: clamp(2rem, 6vw, 4rem);
    align-items: center;
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    margin-bottom: 1.5rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--muted);
    font-size: 0.875rem;
    font-weight: 500;
  }
  .dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--muted);
  }
  .status.open .dot {
    background: var(--ok);
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--ok) 25%, transparent);
  }
  h1 {
    font-size: clamp(2.6rem, 7vw, 4.4rem);
    font-weight: 800;
    letter-spacing: -0.035em;
  }
  .role {
    display: block;
    margin-top: 0.35rem;
    font-size: 0.5em;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--accent-text);
  }
  .tagline {
    margin-top: 1.25rem;
    max-width: 36rem;
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    color: var(--muted);
  }
  .location {
    margin-top: 0.75rem;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.25rem;
    list-style: none;
  }
  .print-contact {
    display: none;
  }
  .portrait {
    justify-self: center;
    width: min(100%, 20rem);
    aspect-ratio: 1;
    border-radius: 28% 72% 62% 38% / 38% 40% 60% 62%;
    background: linear-gradient(145deg, var(--accent-soft), var(--surface-2));
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (max-width: 760px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .portrait {
      order: -1;
      justify-self: start;
      width: 8rem;
    }
  }
  @media print {
    .hero {
      padding-block: 0 1rem;
    }
    .hero::before,
    .status {
      display: none;
    }
    .grid {
      display: block;
    }
    h1 {
      font-size: 22pt;
    }
    .print-contact {
      display: block;
      margin-top: 0.5rem;
      font-size: 9.5pt;
    }
  }
</style>
