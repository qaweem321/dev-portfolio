---
// Dated entries, newest first whatever order the config uses: jobs and education alike.
import Period from "./Period.astro";

interface Props {
  items: { start: string; end?: string; title: string; at: string; location?: string; highlights?: string[] }[];
}

const items = [...Astro.props.items].sort((a, b) => (a.start < b.start ? 1 : a.start > b.start ? -1 : 0));
---

<ol class="timeline">
  {
    items.map((item) => (
      <li class="entry">
        <div class="when">
          <Period start={item.start} end={item.end} />
        </div>
        <div class="what">
          <h3>
            {item.title} <span class="at">· {item.at}</span>
          </h3>
          {item.location && <p class="where">{item.location}</p>}
          {item.highlights && item.highlights.length > 0 && (
            <ul class="highlights">
              {item.highlights.map((highlight) => (
                <li>{highlight}</li>
              ))}
            </ul>
          )}
        </div>
      </li>
    ))
  }
</ol>

<style>
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .entry {
    position: relative;
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: 2rem;
    padding: 1.25rem 0 1.25rem;
  }
  .entry + .entry {
    border-top: 1px dashed var(--border);
  }
  .when {
    font: 500 0.9rem/1.6 var(--mono);
    color: var(--muted);
  }
  h3 {
    font-size: 1.15rem;
  }
  .at {
    color: var(--accent-text);
    font-weight: 600;
  }
  .where {
    margin-top: 0.2rem;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .highlights {
    margin-top: 0.75rem;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.35rem;
    color: var(--muted);
  }
  .highlights li::marker {
    color: var(--accent);
  }
  @media (max-width: 640px) {
    .entry {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }
  }
  @media print {
    .entry {
      grid-template-columns: 10.5rem 1fr;
      gap: 1rem;
      padding: 0.5rem 0;
    }
    .highlights {
      margin-top: 0.3rem;
      gap: 0.1rem;
      color: black;
    }
    .when {
      white-space: nowrap;
    }
  }
</style>
