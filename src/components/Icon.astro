---
// A 24x24 icon from one SVG path. Decorative: the link or button around it carries the name.
interface Props {
  path: string;
  size?: number;
}

const { path, size = 20 } = Astro.props;
---

<svg viewBox="0 0 24 24" width={size} height={size} fill="currentColor" aria-hidden="true" focusable="false">
  <path d={path} />
</svg>
