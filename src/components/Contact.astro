---
import { iconPath } from "../lib/icons";
import type { Portfolio } from "../lib/schema";
import Icon from "./Icon.astro";
import Section from "./Section.astro";

interface Props {
  portfolio: Portfolio;
  index: number;
}

const { portfolio, index } = Astro.props;
const { person, socials } = portfolio;
---

<Section id="contact" index={index} title="Contact" print={false}>
  <div class="contact card">
    <div>
      <p class="lead">Have a role, a project or a question? I reply within two working days.</p>
      {
        person.email && (
          <div class="email-row">
            <span class="address">{person.email}</span>
            <button class="button primary copy needs-js" type="button" data-email={person.email}>
              Copy
            </button>
            <span class="visually-hidden" aria-live="polite" data-copy-status></span>
          </div>
        )
      }
    </div>
    <ul class="list">
      {
        socials.map((social) => (
          <li>
            <a href={social.url} target="_blank" rel="me noopener noreferrer">
              <Icon path={iconPath(social.icon)} size={18} />
              {social.label}<span class="visually-hidden"> (opens in a new tab)</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Section>

<script>
  // Copies the address. If the browser blocks the clipboard, the address is selected instead,
  // ready to copy by hand (Ctrl+C, or a long press on a phone).
  const button = document.querySelector<HTMLButtonElement>(".copy");
  const address = document.querySelector<HTMLElement>(".address");
  const status = document.querySelector<HTMLElement>("[data-copy-status]");
  let reset: ReturnType<typeof setTimeout> | undefined;
  button?.addEventListener("click", async () => {
    let message = "Copied!";
    try {
      await navigator.clipboard.writeText(button.dataset.email ?? "");
    } catch {
      if (address) getSelection()?.selectAllChildren(address);
      message = "Selected: copy it";
    }
    button.textContent = message;
    if (status) status.textContent = message === "Copied!" ? "Email address copied." : "Email address selected.";
    clearTimeout(reset);
    reset = setTimeout(() => {
      button.textContent = "Copy";
      if (status) status.textContent = "";
    }, 2500);
  });
</script>

<style>
  .contact {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 2rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    background: linear-gradient(140deg, var(--accent-soft), var(--surface) 60%);
  }
  .lead {
    font-size: clamp(1.15rem, 2.4vw, 1.45rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    max-width: 28rem;
  }
  .email-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .address {
    padding: 0.55rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface);
    font: 500 0.95rem/1.4 var(--mono);
    overflow-wrap: anywhere;
    user-select: all;
  }
  .copy {
    min-width: 6.5rem;
    justify-content: center;
  }
  .list {
    display: grid;
    gap: 0.25rem;
    list-style: none;
    align-content: center;
  }
  .list a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.75rem;
    border-radius: 10px;
    color: var(--text);
    font-weight: 500;
    text-decoration: none;
  }
  .list a:hover {
    background: var(--surface);
    color: var(--accent-text);
  }
  @media (max-width: 760px) {
    .contact {
      grid-template-columns: 1fr;
    }
  }
</style>
