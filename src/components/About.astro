---
import type { Portfolio } from "../lib/schema";
import Section from "./Section.astro";

interface Props {
  portfolio: Portfolio;
  index: number;
  title: string;
}

const { portfolio, index, title } = Astro.props;
---

<Section id="about" index={index} title={title}>
  <div class="about">
    <div class="prose">
      {portfolio.person.about.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    {
      portfolio.skills.length > 0 && (
        <ul class="skills" aria-label="Skills">
          {portfolio.skills.map((group) => (
            <li>
              <h3>{group.group}</h3>
              <ul class="items">
                {group.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</Section>

<style>
  .about {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: clamp(2rem, 6vw, 4rem);
  }
  .prose {
    display: grid;
    align-content: start;
    gap: 1.1rem;
    font-size: 1.075rem;
    color: var(--muted);
  }
  .skills {
    display: grid;
    align-content: start;
    gap: 1.5rem;
    list-style: none;
  }
  h3 {
    margin-bottom: 0.6rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    list-style: none;
  }
  .items li {
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    font-size: 0.9rem;
    font-weight: 500;
  }
  @media (max-width: 760px) {
    .about {
      grid-template-columns: 1fr;
    }
  }
  @media print {
    .about {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
    .prose {
      font-size: inherit;
      color: black;
    }
    .items {
      gap: 0;
    }
    .items li {
      padding: 0;
      border: 0;
      font-size: inherit;
    }
    .items li:not(:last-child)::after {
      content: ",\00a0";
    }
  }
</style>
