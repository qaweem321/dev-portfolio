---
// The page shell: meta tags for search engines and link previews, structured data, and the theme
// script that runs before anything paints (so dark mode never flashes white).
import "../styles/global.css";
import { asset } from "../lib/paths";
import type { Portfolio } from "../lib/schema";

interface Props {
  portfolio: Portfolio;
}

const { portfolio } = Astro.props;
const { site, person, socials } = portfolio;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const favicon = asset("favicon.svg");
// Link previews need a PNG/JPG at a full address: the configured image, else a photo avatar.
const previewImage = site.image ?? ("src" in person.avatar && !/\.svg$/i.test(person.avatar.src) ? person.avatar.src : undefined);
const ogImage = !previewImage
  ? undefined
  : /^https?:\/\//.test(previewImage)
    ? previewImage
    : Astro.site && new URL(asset(previewImage), Astro.site).href;

// schema.org Person: lets search engines show your name, role and profiles.
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: person.name,
  jobTitle: person.role,
  description: site.description,
  ...(person.email ? { email: `mailto:${person.email}` } : {}),
  ...(canonical ? { url: canonical } : {}),
  sameAs: socials.map((s) => s.url),
};
// JSON.stringify leaves "</script>" alone, which would end the tag early; \u003c is the same "<" in JSON.
const structuredJson = JSON.stringify(structuredData).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang={site.lang} style={`--accent: ${portfolio.theme.accent}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.title}</title>
    <meta name="description" content={site.description} />
    <meta name="author" content={person.name} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="color-scheme" content="light dark" />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href={favicon} type="image/svg+xml" />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={site.title} />
    <meta property="og:description" content={site.description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={site.image && ogImage ? "summary_large_image" : "summary"} />
    <script type="application/ld+json" set:html={structuredJson} />
    <script is:inline>
      // A saved choice wins; without one the CSS follows the system setting (also live, and
      // without JavaScript). Storage can be blocked: fall back quietly.
      (() => {
        try {
          const saved = localStorage.getItem("theme");
          if (saved === "dark" || saved === "light") document.documentElement.dataset.theme = saved;
        } catch {}
        document.documentElement.classList.add("js");
      })();
    </script>
  </head>
  <body>
    <a class="skip-link no-print" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
