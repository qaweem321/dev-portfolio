---
import About from "../components/About.astro";
import Contact from "../components/Contact.astro";
import Experience from "../components/Experience.astro";
import ExternalLink from "../components/ExternalLink.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Projects from "../components/Projects.astro";
import Base from "../layouts/Base.astro";
import { hasContact, portfolio } from "../lib/portfolio";

// Sections with nothing in them are left out, and the rest are numbered in order.
const sections = [
  { id: "about", label: "About", component: About, show: true },
  { id: "projects", label: "Projects", component: Projects, show: portfolio.projects.length > 0 },
  // Education lives in this section too, so a student with no jobs yet still gets it.
  {
    id: "experience",
    label: portfolio.experience.length > 0 ? "Experience" : "Education",
    component: Experience,
    show: portfolio.experience.length > 0 || portfolio.education.length > 0,
  },
  { id: "contact", label: "Contact", component: Contact, show: hasContact(portfolio) },
].filter((section) => section.show);
const year = new Date().getUTCFullYear();
---

<Base portfolio={portfolio}>
  <Header portfolio={portfolio} links={sections.map((s) => ({ href: `#${s.id}`, label: s.label }))} />
  <main id="main">
    <Hero portfolio={portfolio} />
    {sections.map(({ component: Component, id, label }, i) => <Component portfolio={portfolio} id={id} index={i + 1} title={label} />)}
  </main>
  <footer class="footer no-print">
    <div class="container">
      <p>© {year} {portfolio.person.name}</p>
      <p>
        Built with <ExternalLink href="https://github.com/qaweem321/dev-portfolio">dev-portfolio</ExternalLink>
      </p>
    </div>
  </footer>
</Base>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding-block: 2rem;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .footer .container {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
  }
</style>
